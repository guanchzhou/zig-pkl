amends "pkl:Project"

package {
  name = "zig"
  baseUri = "package://pkg.pkl-lang.org/github.com/guanchzhou/zig-pkl/\(name)"
  version = "0.0.0"
  packageZipUrl = "https://github.com/guanchzhou/zig-pkl/releases/download/\(name)@\(version)/\(name)@\(version).zip"
  description = "Annotations for generating Zig bindings from Pkl modules with zig-pkl."
  authors {
    "Andrey Maltsev <maltsev.andrey@gmail.com>"
  }
  license = "Apache-2.0"
  sourceCode = "https://github.com/guanchzhou/zig-pkl"
  sourceCodeUrlScheme = "https://github.com/guanchzhou/zig-pkl/blob/\(name)@\(version)/codegen%{path}#L%{line}-L%{endLine}"
  issueTracker = "https://github.com/guanchzhou/zig-pkl/issues"
  exclude {
    "tests/**"
  }
}
